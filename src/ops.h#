;; ── the dispatcher ─────────────────────────────────────────────────────────

pub fn execute_command(m: &mut model::Model, cmd_str: string) is
    let args: [string] = fields(cmd_str)
    if args.len() == 0 is
        err_status(m, "Empty command")
        return
    end
    let a0: string = args[0]
    let cur_dir: string = m.panels[m.active].dir
    if a0 == "cd" is
        if args.len() < 2 is
            err_status(m, "cd requires a directory")
            return
        end
        let mut new_dir: string = args[1]
        if !vfs::is_abs(new_dir) is new_dir = vfs::join(cur_dir, new_dir) end
        let e: string = vfs::chdir(&mut m.panels[m.active].vfs, new_dir)
        if e != "" is
            err_status(m, "cd: " + e)
            return
        end
        m.panels[m.active].dir = m.panels[m.active].vfs.cwd
        panel::refresh(m, m.active)
    elsif a0 == "mv" is
        move_with_progress(m, args)
    elsif a0 == "rm" is
        prompt_confirm_delete(m)
    elsif a0 == "cp" is
        copy_with_progress(m, args)
    elsif a0 == "touch" is
        if args.len() < 2 is
            err_status(m, "touch requires filename")
            return
        end
        let e: string = vfs::create_empty(m.panels[m.active].vfs, vfs::join(cur_dir, args[1]))
        if e != "" is
            err_status(m, "touch: " + e)
            return
        end
        panel::refresh(m, m.active)
    elsif a0 == "mkdir" is
        if args.len() < 2 is
            err_status(m, "mkdir requires name")
            return
        end
        let e: string = vfs::mkdir_all(m.panels[m.active].vfs, vfs::join(cur_dir, args[1]))
        if e != "" is
            err_status(m, "mkdir: " + e)
            return
        end
        panel::refresh(m, m.active)
    elsif a0 == "hedit" is
        if args.len() < 2 is
            err_status(m, "hedit requires filename")
            return
        end
        open_editor(m, vfs::join(cur_dir, args[1]))
    elsif a0 == "sftp" is
        if args.len() < 2 is
            err_status(m, "sftp requires url sftp://user:pass@host")
            return
        end
        connect_sftp(m, args[1])
    elsif a0 == "podman" is
        if args.len() < 2 is
            err_status(m, "podman requires container id/name")
            return
        end
        connect_podman(m, args[1])
    elsif a0 == "podmanls" is
        list_podman(m)
    else is
        run_system_command(m, a0, rest_args(args))
    end
end
